<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ course_title }}</title>
<link rel="stylesheet" href="{{ css_path }}">
</head>
<body>
<h1>{{ course_title }}</h1>
<p class="breadcrumb">Exported from Stepik course {{ course_id }} on {{ export_date }}</p>

{% for module in modules %}
<section class="toc-module">
  <h2>{{ module.position }}. {{ module.title }}</h2>
  {% for lesson in module.lessons %}
  <div class="toc-lesson">
    <h3>{{ lesson.position }}. {{ lesson.title }}</h3>
    <ul class="toc-steps">
      {% for step in lesson.steps %}
      <li><a href="{{ module.dir_name }}/{{ lesson.dir_name }}/{{ step.dir_name }}/index.html">{{ step.position }}. {{ step.title }}</a></li>
      {% endfor %}
    </ul>
  </div>
  {% endfor %}
</section>
{% endfor %}
</body>
</html>
